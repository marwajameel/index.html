const BLOCKSCOUT_API_KEY = "Proapi_eiBJefkBTRnfKxZLaL9omx8HbXY35eL0ybbKhYqN3SJQ6v2GUxie0dISMqBFqEOwS_bwwaBN";

async function getAddressTransactions(chainId, walletAddress) {
  const endpoint = `https://api.blockscout.com/${chainId}/api/v2/addresses/${walletAddress}/transactions?apikey=${BLOCKSCOUT_API_KEY}`;
  
  try {
    const response = await fetch(endpoint);
    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
    
    const data = await response.json();
    console.log("Blockscout Transactions Data:", data.items);
    return data.items;
  } catch (error) {
    console.error("Blockscout API Fetch Error:", error);
  }
}

// مثال کے طور پر Ethereum (Chain ID: 1) کا ڈیٹا کال کرنے کے لیے:
