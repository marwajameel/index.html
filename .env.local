import { ethers } from 'ethers';

const TATUM_HYPEREVM_RPC = 'https://hyperevm-mainnet.gateway.tatum.io';
const TATUM_API_KEY = 'T-6aada5ee2e4a995e01b3fdf6-edd59d5d95ee46688291765c';

// Tatum HyperEVM Provider
const provider = new ethers.JsonRpcProvider({
  url: TATUM_HYPEREVM_RPC,
  headers: {
    'x-api-key': TATUM_API_KEY,
  },
});

async function getLiveHyperEVMData(walletAddress: string) {
  try {
    const balance = await provider.getBalance(walletAddress);
    console.log(`Live HyperEVM Native Balance: ${ethers.formatEther(balance)}`);
  } catch (error) {
    console.error("HyperEVM RPC Error:", error);
  }
}





