TATUM_API_KEY="T-6aada5ee2e4a995e01b3fdf6-edd59d5d95ee46688291765c"
import { ethers } from 'ethers';

const TATUM_BSC_RPC = 'https://bsc-mainnet.gateway.tatum.io';
const TATUM_API_KEY = 'T-6aada5ee2e4a995e01b3fdf6-edd59d5d95ee46688291765c';

// Tatum BSC Provider بنائیں
const provider = new ethers.JsonRpcProvider({
  url: TATUM_BSC_RPC,
  headers: {
    'x-api-key': TATUM_API_KEY,
  },
});

async function getLiveBNBBalance(walletAddress: string) {
  try {
    const balance = await provider.getBalance(walletAddress);
    console.log(`Live BNB Balance: ${ethers.formatEther(balance)} BNB`);
  } catch (error) {
    console.error("BSC RPC Error:", error);
  }
}

// والٹ کا لائیو بیلنس چیک کریں
getLiveBNBBalance('0xac3b...d6a92f');
