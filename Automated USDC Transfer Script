import os
from web3 import Web3

# 1. نیٹ ورک کنکشن (Base Network RPC)
# اگر آپ بیس نیٹ ورک استعمال کر رہے ہیں تو اس کا آر پی سی درج کریں
w3 = Web3(Web3.HTTPProvider("https://mainnet.base.org"))

# 2. پرائیویٹ کی اور والٹ ایڈریس
OWNER_PRIVATE_KEY = os.environ.get("OWNER_PRIVATE_KEY", "آپ_کی_پرائیویٹ_کی_یہاں_آئے_گی")
sender_address = w3.eth.account.from_key(OWNER_PRIVATE_KEY).address

# 3. OKX ایکسچینج کا ڈپازٹ ایڈریس (جہاں فنڈز بھیجنے ہیں)
OKX_DEPOSIT_ADDRESS = Web3.to_checksum_address("OKX_DEPOSIT_ADDRESS_यहाँ_لکھیں")

# 4. USDC اسمارٹ کانٹریکٹ ایڈریس (Base Network)
USDC_ADDRESS = Web3.to_checksum_address("0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913")

# کم سے کم ABI جو ٹرانسفر کے لیے درکار ہے
ERC20_ABI = [
    {
        "constant": False,
        "inputs": [
            {"name": "_to", "type": "address"},
            {"name": "_value", "type": "uint256"}
        ],
        "name": "transfer",
        "outputs": [{"name": "", "type": "bool"}],
        "type": "function"
    },
    {
        "constant": True,
        "inputs": [{"name": "_owner", "type": "address"}],
        "name": "balanceOf",
        "outputs": [{"name": "balance", "type": "uint256"}],
        "type": "function"
    }
]

contract = w3.eth.contract(address=USDC_ADDRESS, abi=ERC20_ABI)

def send_usdc_to_okx(amount_in_usdc):
    # USDC کے 6 decimals ہوتے ہیں
    amount_in_wei = int(amount_in_usdc * 10**6)
    
    # بیلنس چیک کریں
    balance = contract.functions.balanceOf(sender_address).call()
    if balance < amount_in_wei:
        print("❌ ایرر: آپ کے والٹ میں مطلوبہ USDC بیلنس موجود نہیں ہے!")
        return

    nonce = w3.eth.get_transaction_count(sender_address)
    
    # ٹرانزیکشن بلڈ کریں
    txn = contract.functions.transfer(OKX_DEPOSIT_ADDRESS, amount_in_wei).build_transaction({
        'chainId': 8453, # Base Chain ID
        'gas': 100000,
        'gasPrice': w3.eth.gas_price,
        'nonce': nonce,
    })

    # سائن اور براڈکاسٹ کریں
    signed_txn = w3.eth.account.sign_transaction(txn, private_key=OWNER_PRIVATE_KEY)
    tx_hash = w3.eth.send_raw_transaction(signed_txn.raw_transaction)
    
    print(f"✅ فنڈز کامیابی سے منتقل ہو رہے ہیں! ٹرانزیکشن ہیش: {w3.to_hex(tx_hash)}")

# مثال کے طور پر 100 USDC ایکسچینج پر بھیجنے کے لیے:
# send_usdc_to_okx(100)
