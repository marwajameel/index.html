def get_evm_balance(rpc_url, address):
    payload = {"jsonrpc": "2.0", "method": "eth_getBalance", "params": [address, "latest"], "id": 1}
    try:
        res = requests.post(rpc_url, json=payload, timeout=8)
        if res.status_code == 200:
            wei = int(res.json().get("result", "0x0"), 16)
            return wei / 1e18
    except Exception:
        pass
    return 0.0

def get_erc20_balance(rpc_url, contract_address, wallet_address, decimals=18):
    clean_addr = wallet_address.lower().replace("0x", "").zfill(64)
    data = f"0x70a08231{clean_addr}"
    payload = {
        "jsonrpc": "2.0",
        "method": "eth_call",
        "params": [{"to": contract_address, "data": data}, "latest"],
        "id": 1
    }
    try:
        res = requests.post(rpc_url, json=payload, timeout=8)
        if res.status_code == 200:
            raw_hex = res.json().get("result", "0x0")
            if raw_hex and raw_hex != "0x":
                return int(raw_hex, 16) / (10 ** decimals)
    except Exception:
        pass
    return 0.0

def get_solana_balance(address):
    if "..." in address:
        return 0.0
    payload = {"jsonrpc": "2.0", "id": 1, "method": "getBalance", "params": [address]}
    try:
        res = requests.post(SOLANA_RPC_URL, json=payload, timeout=8)
        if res.status_code == 200:
            lamports = res.json().get("result", {}).get("value", 0)
            return lamports / 1e9
    except Exception:
        pass
    return 0.0

def get_btc_balance(address):
    url = f"https://blockstream.info/api/address/{address}"
    try:
        res = requests.get(url, timeout=8)
        if res.status_code == 200:
            data = res.json()
            funded = data.get("chain_stats", {}).get("funded_txo_sum", 0)
            spent = data.get("chain_stats", {}).get("spent_txo_sum", 0)
            return (funded - spent) / 1e8
    except Exception:
        pass
    return 0.0

