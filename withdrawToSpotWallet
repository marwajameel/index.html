pragma solidity ^0.8.20;

import "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import "@openzeppelin/contracts/access/Ownable.sol";

contract MJ04AutoProfitManager is Ownable {
    address public spotWallet;
    uint256 public constant DAILY_TARGET_VOLUME = 100000; // $100k volume baseline

    event SpotWithdrawal(address indexed token, uint256 amount, uint256 timestamp);

    constructor(address _spotWallet) Ownable(msg.sender) {
        spotWallet = _spotWallet;
    }

    // خودکار فیس اور پرافٹ کو سپورٹ والٹ میں منتقل کرنے کا فنکشن
    function withdrawToSpotWallet(address tokenAddress) external onlyOwner {
        IERC20 token = IERC20(tokenAddress);
        uint256 balance = token.balanceOf(address(this));
        require(balance > 0, "Insufficient balance for transaction");

        bool success = token.transfer(spotWallet, balance);
        require(success, "Transfer to spot wallet failed");

        emit SpotWithdrawal(tokenAddress, balance, block.timestamp);
    }

    function setSpotWallet(address _newSpotWallet) external onlyOwner {
        spotWallet = _newSpotWallet;
    }
}
