# ==========================================
# 2. Bitget v2 سائننگ فنکشن (Authentication)
# ==========================================
def get_signature(timestamp, method, request_path, query_string="", body=""):
    message = timestamp + method.upper() + request_path + query_string + body
    mac = hmac.new(SECRET_KEY.encode('utf-8'), message.encode('utf-8'), hashlib.sha256)
    return mac.hexdigest()

def get_headers(method, request_path, query_string="", body=""):
    timestamp = str(int(time.time() * 1000))
    sign = get_signature(timestamp, method, request_path, query_string, body)
    
    headers = {
        "ACCESS-KEY": API_KEY,
        "ACCESS-SIGN": sign,
        "ACCESS-TIMESTAMP": timestamp,
        "ACCESS-PASSPHRASE": PASSPHRASE,
        "Content-Type": "application/json",
        "locale": "en-US"
    }
    return headers

# ==========================================
# 3. فیوچرز والٹ بیلنس چیک کرنا
# ==========================================
def get_futures_balance():
    path = "/api/v2/mix/account/accounts"
    query = "?productType=USDT-FUTURES"
    headers = get_headers("GET", path, query_string=query)
    
    url = BASE_URL + path + query
    response = requests.get(url, headers=headers)
    data = response.json()
    
    if data.get("code") == "00000":
        for asset in data.get("data", []):
            if asset.get("marginCoin") == "USDT":
                # 'available' یا 'maxTransferAmount' حاصل کرنا
                return float(asset.get("available", 0.0))
    else:
        print(f"❌ بیلنس حاصل کرنے میں غلطی: {data.get('msg')}")
    return 0.0

# ==========================================
# 4. فیوچرز سے اسپاٹ والٹ میں منافع منتقل کرنا
# ==========================================
def transfer_profit_to_spot(amount):
    path = "/api/v2/account/transfer"
    
    body_data = {
        "fromType": "usdt_futures",  # فیوچرز اکاؤنٹ
        "toType": "spot",           # اسپاٹ اکاؤنٹ
        "coin": "USDT",
        "amount": str(round(amount, 2))
    }
    
    body_str = json.dumps(body_data)
    headers = get_headers("POST", path, body=body_str)
    
    url = BASE_URL + path
    response = requests.post(url, headers=headers, data=body_str)
    data = response.json()
    
    if data.get("code") == "00000":
        print(f"✅ کامیا بی! {amount:.2f} USDT کامیا بی سے Spot Wallet میں منتقل کر دیے گئے ہیں۔")
        print(f"ٹرانسفر ID: {data.get('data', {}).get('transferId')}")
    else:
        print(f"❌ ٹرانسفر میں ناکامی: {data.get('msg')}")

