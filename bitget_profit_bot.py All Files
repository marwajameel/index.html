    if futures_balance > INITIAL_CAPITAL:
        profit = futures_balance - INITIAL_CAPITAL
        print(f"🎯 نیا منافع تیار ہے: {profit:.2f} USDT")
        
        if profit >= 1.0:  # کم از کم 1 USDT ٹرانسفر کے لیے شرط
