const API_KEY = "jup_bff749c83083de95b6275a4b9c9fbc2b9e0401f3c22628ce7d75f73c42aeb82c";

async function fetchData(query) {
    try {
        const response = await fetch(`https://api.jup.ag/tokens/v1/search?query=${query}`, {
            headers: {
                'x-api-key': API_KEY
            }
        });
        const data = await response.json();
        return data;
    } catch (error) {
        console.error("ایرر آ गया:", error);
    }
}
